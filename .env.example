# Public Supabase settings (safe only with correctly configured RLS)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY

# Server-side only — never use NEXT_PUBLIC_ prefix
SUPABASE_SERVICE_ROLE_KEY=REPLACE_IF_NEEDED
NEBIUS_API_KEY=REPLACE_ME
NEBIUS_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1/
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b
GITHUB_TOKEN=REPLACE_ME
GITHUB_ALLOWED_REPOS=YOUR_USERNAME/repomedic-fixture
GITHUB_FIXTURE_BASE_SHA=REPLACE_WITH_KNOWN_FAILING_SHA

# Configure Vercel Sandbox authentication through official Vercel integration docs.
# Optional opt-in Resend email notification (server-side only):
RESEND_API_KEY=REPLACE_IF_USING_RESEND
RESEND_FROM_EMAIL="RepoMedic <info@ensure.in>"
